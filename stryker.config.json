{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/services/api.ts",
    "src/services/backend/client.ts",
    "src/services/board.ts",
    "src/services/rides.ts",
    "src/services/payments.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 80
  },
  "concurrency": 4,
  "incremental": true,
  "ignorePatterns": [
    "load-tests/.venv/**",
    "tests/load/.venv/**",
    "coverage/**",
    "reports/**"
  ]
}
