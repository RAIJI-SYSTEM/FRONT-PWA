# Copie para .env.local e preencha. Variáveis NEXT_PUBLIC_ ficam visíveis no navegador.

# Backend Raiji (monolito) pelo Kong — a mesma porta do login. No app Android, use o IP do PC (ex.: http://192.168.0.10:8000)
NEXT_PUBLIC_RAIJI_API_URL=http://localhost:8000

# Mapbox — https://account.mapbox.com/access-tokens (token público, restrinja por URL)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Gerado pelo `stripe listen --forward-to localhost:3000/api/stripe/webhook` (dev) ou no Dashboard (produção)
STRIPE_WEBHOOK_SECRET=whsec_...

# Anúncios (opcional). Sem isso, a tela de espera mostra promoções do próprio app.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_WAITING=
NEXT_PUBLIC_ADSENSE_SLOT_MORE=

# AdMob (app nativo via Capacitor). Enquanto NEXT_PUBLIC_ADMOB_TESTING não for "false",
# o app usa os blocos de TESTE do Google — use sempre eles durante o desenvolvimento.
NEXT_PUBLIC_ADMOB_TESTING=true
NEXT_PUBLIC_ADMOB_SHORT_ANDROID=
NEXT_PUBLIC_ADMOB_SHORT_IOS=
NEXT_PUBLIC_ADMOB_LONG_ANDROID=
NEXT_PUBLIC_ADMOB_LONG_IOS=
# Libera a rota de anúncio simulado (/api/rewards/ad-watched) em produção. Deixe vazio.
ADS_MOCK=

# App Android (npm run build:mobile): endereço do servidor Next visto pelo celular, na mesma rede Wi-Fi.
# Rode o servidor com npm run dev:lan. Descubra o IP do PC com: hostname -I
MOBILE_API_URL=http://192.168.0.10:3000

# Login (Keycloak atrás do Kong, repositório monolith: docker compose up).
# No app Android use o IP do PC (ex.: http://192.168.0.10:8000), não localhost.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_REALM=raiji
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=raiji-api
